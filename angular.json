{
    "$schema":  "./node_modules/@angular/cli/lib/config/schema.json",
    "version":  1,
    "cli":  {
                "packageManager":  "npm",
                "analytics":  false
            },
    "newProjectRoot":  "projects",
    "projects":  {
                     "sqllab":  {
                                    "projectType":  "application",
                                    "schematics":  {

                                                   },
                                    "root":  "",
                                    "sourceRoot":  "src",
                                    "prefix":  "app",
                                    "architect":  {
                                                      "build":  {
                                                                    "builder":  "@angular/build:application",
                                                                    "options":  {
                                                                                    "browser":  "src/main.ts",
                                                                                    "tsConfig":  "tsconfig.app.json",
                                                                                    "externalDependencies":  [
                                                                                                                 "node:module"
                                                                                                             ],
                                                                                    "assets":  [
                                                                                                   {
                                                                                                       "glob":  "**/*",
                                                                                                       "input":  "public"
                                                                                                   },
                                                                                                   {
                                                                                                       "glob":  "**/*",
                                                                                                       "input":  "node_modules/monaco-editor/min/vs",
                                                                                                       "output":  "assets/monaco/vs"
                                                                                                   },
                                                                                                   {
                                                                                                       "glob":  "{pglite.wasm,pglite.data,initdb.wasm}",
                                                                                                       "input":  "node_modules/@electric-sql/pglite/dist",
                                                                                                       "output":  "assets/pglite"
                                                                                                   }
                                                                                               ],
                                                                                    "allowedCommonJsDependencies":  [
                                                                                                                        "nearley"
                                                                                                                    ],
                                                                                    "styles":  [
                                                                                                   "src/styles.css"
                                                                                               ]
                                                                                },
                                                                    "configurations":  {
                                                                                           "production":  {
                                                                                                              "budgets":  [
                                                                                                                              {
                                                                                                                                  "type":  "initial",
                                                                                                                                  "maximumWarning":  "5MB",
                                                                                                                                  "maximumError":  "10MB"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "type":  "anyComponentStyle",
                                                                                                                                  "maximumWarning":  "20kB",
                                                                                                                                  "maximumError":  "40kB"
                                                                                                                              }
                                                                                                                          ],
                                                                                                              "outputHashing":  "all"
                                                                                                          },
                                                                                           "development":  {
                                                                                                               "optimization":  false,
                                                                                                               "extractLicenses":  false,
                                                                                                               "sourceMap":  true
                                                                                                           }
                                                                                       },
                                                                    "defaultConfiguration":  "production"
                                                                },
                                                      "serve":  {
                                                                    "builder":  "@angular/build:dev-server",
                                                                    "configurations":  {
                                                                                           "production":  {
                                                                                                              "buildTarget":  "sqllab:build:production"
                                                                                                          },
                                                                                           "development":  {
                                                                                                               "buildTarget":  "sqllab:build:development"
                                                                                                           }
                                                                                       },
                                                                    "defaultConfiguration":  "development"
                                                                },
                                                      "test":  {
                                                                   "builder":  "@angular/build:unit-test",
                                                                   "options":  {
                                                                                   "setupFiles":  [
                                                                                                      "src/test-setup.ts"
                                                                                                  ]
                                                                               }
                                                               }
                                                  }
                                }
                 }
}